// hello.s16c — write "HELLO, S16!" into the framebuffer.
// The s16c counterpart to programs/asm/hello.s16: screen::print with a
// string literal instead of hand-computing the framebuffer address and
// packing the attribute byte.
// See it on screen:
//   cargo run -p s16c -- programs/s16c/hello.s16c --bin
//   cargo run -p s16-emulator -- --tui programs/s16c/hello.bin

use screen;

fn main() {
    screen::print(0, 0, "HELLO, S16!", screen::WHITE);
    halt();
}
