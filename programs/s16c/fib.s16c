// fib.s16c — fib(10), recursively. fib(0)=0, fib(1)=1, fib(10)=55.
// The s16c counterpart to programs/asm/fib.s16, which is iterative because
// hand-written assembly has to build its own stack frames to recurse. In
// s16c every function gets one for free (CALLING_CONVENTION.md), so
// recursion is just... calling yourself.
// Run with:
//   cargo run -p s16c -- programs/s16c/fib.s16c --bin
//   cargo run -p s16-emulator -- programs/s16c/fib.bin

use debug;

fn fib(n: u16) -> u16 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    debug::print_u16(fib(10));   // 55
    halt();
}
