// sum.s16c — total of five numbers, the s16c counterpart to
// programs/asm/sum.s16. Doubles as the smallest "compile, run, read a
// result" example in the language: static array, a loop, print the answer.
// Run with (no --tui needed — debug::print* works in batch mode too):
//   cargo run -p s16c -- programs/s16c/sum.s16c --bin
//   cargo run -p s16-emulator -- programs/s16c/sum.bin

use debug;

static DATA: [u16; 5] = [10, 20, 30, 40, 50];

fn main() {
    var total: u16 = 0;
    var i: u16 = 0;
    while i < 5 {
        total = total + DATA[i];
        i = i + 1;
    }
    debug::print_u16(total);   // 150
    halt();
}
