// walk.s16c — arrow keys move '@' around the display.
// Written entirely against the standard library (screen/input/time) — no
// raw addresses. Build and run:
//   cargo run -p s16c -- programs/walk.s16c --bin
//   cargo run -p s16-emulator -- --tui programs/walk.bin

use screen;
use input;
use time;

static X: u16 = 20;
static Y: u16 = 12;

fn main() {
    loop {
        var keys: u16 = read_input();
        put_cell(X, Y, ' ', BLACK);            // erase old position
        if key_left(keys)  && X > 0             { X = X - 1; }
        if key_right(keys) && X < SCREEN_W - 1  { X = X + 1; }
        if key_up(keys)    && Y > 0             { Y = Y - 1; }
        if key_down(keys)  && Y < SCREEN_H - 1  { Y = Y + 1; }
        put_cell(X, Y, '@', GREEN);
        wait_tick();
    }
}
