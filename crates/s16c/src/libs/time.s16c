// The `time` library (specs/LANGUAGE.md §7.3): the machine tick counter.
// `use time;` then call `time::tick`/`time::wait_next` to pace a game loop.

fn tick() -> u16 {
    return peek(0xFF04);
}

// Block until the machine advances one tick: the frame pacer for game loops.
// Parks the CPU (WAITTICK) rather than busy-polling TICK — TICK is written
// once at the start of a tick and held fixed while the CPU runs, so a
// software poll loop can never observe it change before the tick's whole
// instruction budget is spent (D028).
fn wait_next() {
    wait_tick();
}
