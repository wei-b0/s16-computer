// The `time` library (specs/LANGUAGE.md §7.3): the machine tick counter.
// `use time;` to pace a game loop.

fn ticks() -> u16 {
    return peek(0xFF04);
}

// Block until the machine advances one tick: the frame pacer for game loops.
fn wait_tick() {
    var t: u16 = peek(0xFF04);
    while peek(0xFF04) == t { }
}
