// The `input` library (specs/LANGUAGE.md §7.2): the keyboard/gamepad.
// `use input;` then call `input::read`, `input::key_*`.

fn read() -> u16 {
    return peek(0xFF00);
}

fn key_up(keys: u16) -> bool { return keys & 1 != 0; }
fn key_down(keys: u16) -> bool { return keys & 2 != 0; }
fn key_left(keys: u16) -> bool { return keys & 4 != 0; }
fn key_right(keys: u16) -> bool { return keys & 8 != 0; }
fn key_a(keys: u16) -> bool { return keys & 16 != 0; }
fn key_b(keys: u16) -> bool { return keys & 32 != 0; }
fn key_start(keys: u16) -> bool { return keys & 64 != 0; }
fn key_select(keys: u16) -> bool { return keys & 128 != 0; }

// Block until a key is held, then return the bitmask — the blocking
// counterpart to `read()`. Re-reads after waking rather than trusting the
// pre-wait snapshot, since a key could in principle release again before
// the caller acts on it.
fn wait_key() -> u16 {
    var keys: u16 = read();
    if keys == 0 {
        wait();
        keys = read();
    }
    return keys;
}
